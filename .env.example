# JML Orchestrator :: environment reference
#
# NOTHING in this project reads this file automatically. It is the single
# document that tells you (and anyone cloning the repo) which values must exist
# and where each one is actually entered. Copy to .env and fill it in for your
# own reference; the real values live in n8n's credential store and in the
# mock IdP's process environment.

# ── Mock IdP ────────────────────────────────────────────────────────────────
# Set in the PowerShell session that runs uvicorn, and entered again in n8n as
# the value of the "X-API-Key" header credential.
MOCK_IDP_API_KEY=dev-mock-idp-key-change-me
MOCK_IDP_BASE_URL=http://127.0.0.1:8100

# ── Postgres (Neon free tier) ───────────────────────────────────────────────
# Entered in n8n under Credentials > Postgres account. Not read from here.
PGHOST=ep-xxxx-xxxx.ap-southeast-1.aws.neon.tech
PGPORT=5432
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=
PGSSLMODE=require

# ── n8n runtime ─────────────────────────────────────────────────────────────
# Set these as environment variables BEFORE the first `n8n start`.
# N8N_ENCRYPTION_KEY must never change once credentials have been saved.
N8N_ENCRYPTION_KEY=
GENERIC_TIMEZONE=Asia/Manila
TZ=Asia/Manila
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/   # n8n 2.x name; WEBHOOK_URL is deprecated
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# ── SMTP for approval emails (Gmail app password) ───────────────────────────
# Entered in n8n under Credentials > SMTP account.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SSL=true
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
APPROVER_EMAIL=you@gmail.com
ITSEC_ALERT_EMAIL=you@gmail.com

# ── Google Gemini (Stage 3 only) ────────────────────────────────────────────
# Entered in n8n under Credentials > Google Gemini(PaLM) Api account.
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-flash-latest

# ── Domain used to derive work emails ───────────────────────────────────────
# Hardcoded as a const at the top of the "Normalize Request" Code node.
WORK_EMAIL_DOMAIN=demo-corp.test

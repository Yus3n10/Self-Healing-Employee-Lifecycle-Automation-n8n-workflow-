      "id": "964abac6-d8ec-4e55-a102-1565f708f6e1",
      "name": "Verify Effect",
      "retryOnFail": true,
      "waitBetweenTries": 2000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "agBb05wkTODDn2Ls",
          "name": "Mock IdP Key"

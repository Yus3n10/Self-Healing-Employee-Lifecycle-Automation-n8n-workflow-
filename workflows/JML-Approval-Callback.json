    {
      "parameters": {
        "jsCode": "const q = ($input.first().json.query) || {};\nlet token = String(q.token || '').trim();\nlet decision = String(q.decision || '').trim().toLowerCase();\n\n// Recover from a mail client that ate the & between the two parameters.\nconst glued = token.match(/^([0-9a-f]{32})decision=(approve|reject)$/i);\nif (glued) { token = glued[1]; decision = glued[2].toLowerCase(); }\n\nconst clientIp = String(\n  ($input.first().json.headers || {})['x-forwarded-for'] || 'local'\n);\n\nreturn [{\n  json: {\n    token,\n    decision: decision === 'approve' ? 'approved'\n            : decision === 'reject'  ? 'rejected'\n            : '',\n    client_ip: clientIp,\n    input_ok: token.length === 32 && ['approve', 'reject'].includes(decision),\n    debug_raw_token_len: String(q.token || '').length,\n    debug_raw_decision: String(q.decision || ''),\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        144,

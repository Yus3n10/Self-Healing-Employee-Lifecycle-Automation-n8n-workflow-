    {
      "parameters": {
        "jsCode": "const run = $('Create Offboard Run').first().json;\nconst emp = $('Find Due Offboardings').first().json;\nconst res = $input.first().json;\n\n// A missing account is a data problem for ONE employee. It must not abort the\n// batch. Emit a zero-step plan; the run closes as completed with nothing to do.\nif (res.statusCode !== 200) {\n  return [{\n    json: {\n      _no_account: true,\n      run_id: run.id,\n      employee_ref: emp.employee_ref,\n      work_email: emp.work_email,\n      idp_status: res.statusCode,\n    },\n  }];\n}\nconst user = res.body || {};\nconst root = `offboard:${emp.employee_ref}:${emp.end_date}`;\nconst steps = [];\n\nsteps.push({ step_order: 10, action_type: 'revoke_sessions', resource: '' });\nlet o = 20;\nfor (const g of (user.groups || []))   steps.push({ step_order: o++, action_type: 'remove_group',   resource: g });\no = 50;\nfor (const s of (user.licenses || [])) steps.push({ step_order: o++, action_type: 'revoke_license', resource: s });\nsteps.push({ step_order: 90, action_type: 'suspend_account', resource: '' });\n\nreturn steps.map(s => ({\n  json: {\n    _no_account: false,\n    run_id: run.id,\n    step_order: s.step_order,\n    action_type: s.action_type,\n    target_system: 'mockidp',\n    resource: s.resource,\n    is_privileged: false,\n    idempotency_key: `${root}:${s.step_order}:${s.action_type}:${s.resource}`,\n    status: 'pending',\n  },\n}));"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1136,
        -336
      ],
      "id": "9d7cf52b-c6c1-44a2-971f-31cb6e0ddb04",
      "name": "Build Offboard Steps"
    },

    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT count(*)                                                          AS reviewed,\n       count(*) FILTER (WHERE (detail->>'drift')::boolean)               AS drifted,\n       count(*) FILTER (WHERE detail->>'finding' = 'excess_access')      AS excess_access,\n       count(*) FILTER (WHERE detail->>'finding' = 'incomplete_provisioning') AS incomplete,\n       count(*) FILTER (WHERE detail->>'finding' = 'no_account')         AS no_account,\n       COALESCE(jsonb_agg(detail) FILTER (WHERE (detail->>'drift')::boolean), '[]'::jsonb) AS findings\nFROM audit_events\nWHERE event_type = 'access_reviewed'\n  AND detail->>'review_batch' = $1",
        "options": {
          "queryReplacement": "={{ $execution.id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,

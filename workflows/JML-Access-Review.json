        "subject": "={{ 'Access review: ' + $json.drifted + ' of ' + $json.reviewed + ' accounts have drift' }}",
        "html": "=<div style=\"font-family:system-ui,sans-serif;max-width:680px\">\n  <h2 style=\"margin:0 0 8px\">Weekly access review</h2>\n  <table cellpadding=\"6\" style=\"border-collapse:collapse;font-size:14px\">\n    <tr><td><b>Reviewed</b></td><td>{{ $json.reviewed }}</td></tr>\n    <tr><td><b>With drift</b></td><td>{{ $json.drifted }}</td></tr>\n    <tr><td style=\"color:#991b1b\"><b>Excess access</b></td><td style=\"color:#991b1b\">{{ $json.excess_access }}</td></tr>\n    <tr><td><b>Incomplete provisioning</b></td><td>{{ $json.incomplete }}</td></tr>\n    <tr><td><b>No account</b></td><td>{{ $json.no_account }}</td></tr>\n  </table>\n  <h3 style=\"margin:20px 0 6px;font-size:14px\">Findings</h3>\n  <pre style=\"background:#f4f4f5;padding:12px;border-radius:6px;font-size:12px;white-space:pre-wrap\">{{ $json.findings.slice(0, 10).map(f => f.employee_ref + '  ' + f.role_code + '  ' + f.finding + (f.extra_groups.length ? '  EXCESS: ' + f.extra_groups.join(',') : '') + (f.missing_groups.length ? '  MISSING: ' + f.missing_groups.join(',') : '')).join('\\n') }}</pre>\n<p style=\"font-size:12px;color:#777\">{{ $json.findings.length > 10 ? 'Showing 10 of ' + $json.findings.length + '. Full detail in audit_events.' : '' }}</p>\n</div>",
        "options": {}

    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT s.id            AS step_id,\n       s.step_order,\n       s.action_type,\n       s.resource,\n       s.idempotency_key,\n       e.work_email\nFROM provisioning_steps s\nJOIN provisioning_runs  r ON r.id = s.run_id\nJOIN employees          e ON e.id = r.employee_id\nWHERE s.run_id = $1::uuid\n  AND s.status = 'succeeded'\nORDER BY s.step_order DESC;",
        "options": {
          "queryReplacement": "={{ $('When Executed by Another Workflow').first().json.run_id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        192,
        0
      ],
      "id": "9cbba967-7da8-47f7-a31c-4e01d61fe363",
      "name": "Load Succeeded Steps",
      "alwaysOutputData": true,
      "credentials": {
        "postgres": {
          "id": "dJOXoEvmjfshJ1MX",
          "name": "JML Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const IDP_BASE = 'http://127.0.0.1:8100';\nconst runId = $('When Executed by Another Workflow').first().json.run_id;\n\nconst INVERSE = {\n  create_account:  'delete_account',\n  add_group:       'remove_group',\n  assign_license:  'revoke_license',\n  // Offboarding actions are NOT compensated. Re-granting access that was\n  // deliberately revoked is never the safe default; a human re-runs onboarding.\n  revoke_sessions: null,\n  remove_group:    null,\n  revoke_license:  null,\n  suspend_account: null,\n  delete_account:  null,\n};\n\nconst out = [];\nfor (const item of $input.all()) {\n  const s = item.json;\n  if (!s || !s.step_id) continue;   // empty item from Always Output Data\n\n  const inverse = INVERSE[s.action_type];\n  if (!inverse) {\n    out.push({ json: { ...s, run_id: runId, compensable: false,\n                       reason: `no inverse for ${s.action_type}` } });\n    continue;\n  }\n\n  const email = encodeURIComponent(s.work_email);\n  const res = encodeURIComponent(s.resource || '');\n  let method, path;\n\n  if (inverse === 'delete_account')      { method = 'DELETE'; path = `/v1/users/${email}`; }\n  else if (inverse === 'remove_group')   { method = 'DELETE'; path = `/v1/users/${email}/groups/${res}`; }\n  else if (inverse === 'revoke_license') { method = 'DELETE'; path = `/v1/users/${email}/licenses/${res}`; }\n\n  out.push({\n    json: {\n      ...s,\n      run_id: runId,\n      compensable: true,\n      inverse_action: inverse,\n      method,\n      url: IDP_BASE + path,\n      // Distinct key: undoing is a different logical operation from doing, so\n      // it must not collide with the original's stored idempotent response.\n      compensation_key: `undo:${s.idempotency_key}`,\n    },\n  });\n}\n\nreturn out;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        0
      ],
      "id": "a14a5bfd-b85c-4bce-9fe2-b90bbe5f1ed0",
      "name": "Build Compensations"

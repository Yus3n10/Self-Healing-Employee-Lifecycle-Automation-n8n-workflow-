    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT count(*) FILTER (WHERE status = 'compensated')         AS compensated,\n       count(*) FILTER (WHERE status = 'compensation_failed') AS compensation_failed,\n       count(*) FILTER (WHERE status = 'succeeded')           AS still_succeeded,\n       count(*) FILTER (WHERE status = 'failed')              AS failed\nFROM provisioning_steps\nWHERE run_id = $1::uuid;",
        "options": {
          "queryReplacement": "={{ $('When Executed by Another Workflow').first().json.run_id }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        736,
        -208
      ],
      "id": "a9f068b8-6972-474d-9b7f-c71f83bfeb14",
      "name": "Summarise Rollback",
      "credentials": {
        "postgres": {
          "id": "dJOXoEvmjfshJ1MX",
          "name": "JML Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const s = $input.first().json;\nconst failed = Number(s.compensation_failed || 0);\nreturn [{\n  json: {\n    run_id: $('When Executed by Another Workflow').first().json.run_id,\n    compensated: Number(s.compensated || 0),\n    compensation_failed: failed,\n    still_succeeded: Number(s.still_succeeded || 0),\n    failed_steps: Number(s.failed || 0),\n    clean: failed === 0,\n    // 'rolled_back' means the system is clean.\n    // 'failed' means something could not be undone and a human must look.\n    run_status: failed === 0 ? 'rolled_back' : 'failed',\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -208
      ],
      "id": "100434ed-6b77-4a0f-b26e-35d1a469529f",

    {
      "parameters": {
        "jsCode": "const ctx = $('Compensable?').first().json;\nconst r = $input.first().json;\n\nconst code = Number(r.statusCode ?? 0);\nconst ok = code >= 200 && code < 300;\n\nreturn [{\n  json: {\n    step_id: ctx.step_id,\n    run_id: ctx.run_id,\n    inverse_action: ctx.inverse_action,\n    resource: ctx.resource,\n    status_code: code,\n    status: ok ? 'compensated' : 'compensation_failed',\n    last_error: ok ? null\n      : String('undo failed: ' + JSON.stringify(r.error ?? r.body ?? {})).slice(0, 900),\n  },\n}];"
      },
